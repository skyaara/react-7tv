{
  "name": "react-7tv",
  "version": "0.1.0",
  "description": "Composable, SSR-safe React components for replacing inline text with 7TV emotes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/client/index.cjs",
  "module": "./dist/client/index.js",
  "types": "./dist/client/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/client",
    "dist/core",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.6.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "workspaces": [
    "examples/*"
  ],
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.2"
    }
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run publint",
    "check:all": "npm run check && npm run examples:build",
    "examples:build": "npm run build --workspace @react-7tv/example-vite && npm run build --workspace @react-7tv/example-next && npm run build --workspace @react-7tv/example-react-router && npm run build --workspace @react-7tv/marketing",
    "lint": "npm run typegen --workspace @react-7tv/example-react-router && eslint .",
    "marketing:dev": "npm run dev --workspace @react-7tv/marketing",
    "prepublishOnly": "npm run check",
    "publint": "publint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@testing-library/react": "^16.3.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "7tv",
    "emotes",
    "react",
    "twitch",
    "kick",
    "youtube"
  ]
}
