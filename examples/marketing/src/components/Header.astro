---
import Logo from "./Logo.astro";

const repositoryUrl = import.meta.env.PUBLIC_REPOSITORY_URL ?? "/examples/";
---

<header class="site-header">
  <div class="shell header-inner">
    <Logo />
    <nav aria-label="Main navigation">
      <a href="#playground">Playground</a>
      <a href="#api">API</a>
      <a href="/examples/">Examples</a>
    </nav>
    <a class="github-link" href={repositoryUrl} aria-label="View project source">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.24c-3.24.7-3.92-1.38-3.92-1.38-.53-1.35-1.29-1.71-1.29-1.71-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.75.4-1.27.74-1.56-2.58-.3-5.3-1.29-5.3-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18a10.96 10.96 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.72 5.39-5.31 5.68.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
      </svg>
      <span>Source</span>
    </a>
  </div>
</header>

<style>
  .site-header { position: relative; z-index: 20; border-bottom: 1px solid var(--line); }
  .header-inner { height: 78px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
  nav { display: flex; gap: 32px; }
  nav a, .github-link { color: var(--muted); text-decoration: none; font: 620 11px/1 var(--sans); transition: color .2s ease; }
  nav a:hover, .github-link:hover { color: var(--ink); }
  .github-link { justify-self: end; display: flex; align-items: center; gap: 8px; }
  .github-link svg { width: 17px; fill: currentColor; }
  @media (max-width: 720px) {
    .header-inner { grid-template-columns: 1fr auto; }
    nav { display: none; }
  }
</style>
