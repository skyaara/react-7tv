---
import BaseLayout from "../../layouts/BaseLayout.astro";

const examples = [
  {
    id: "vite",
    number: "01",
    title: "Vite SPA",
    type: "Client rendered",
    summary: "Remote set hydration, syntax switching, and animation control in a minimal React 19 application.",
    command: "npm run dev --workspace @react-7tv-wrapper/example-vite",
    files: ["src/App.tsx", "src/main.tsx", "src/styles.css"],
    accent: "#a98bff",
  },
  {
    id: "next",
    number: "02",
    title: "Next.js App Router",
    type: "React Server Components",
    summary: "Fetch with the server-safe /core entry, then pass serializable data into an interactive client boundary.",
    command: "npm run dev --workspace @react-7tv-wrapper/example-next",
    files: ["app/page.tsx", "app/EmoteMessage.tsx", "app/styles.css"],
    accent: "#7654d5",
  },
  {
    id: "react-router",
    number: "03",
    title: "React Router",
    type: "Framework-mode SSR",
    summary: "Load the emote set in a route loader, server render it, and hydrate the same component tree.",
    command: "npm run dev --workspace @react-7tv-wrapper/example-react-router",
    files: ["app/routes/home.tsx", "app/root.tsx", "react-router.config.ts"],
    accent: "#4f8a63",
  },
  {
    id: "astro",
    number: "04",
    title: "Astro + React",
    type: "Hydrated island",
    summary: "Keep the marketing shell static while hydrating only the interactive React emote playground.",
    command: "npm run marketing:dev",
    files: ["src/pages/index.astro", "src/components/Playground.tsx", "astro.config.mjs"],
    accent: "#d9ff43",
  },
];
---

<BaseLayout
  title="Framework examples · react-7tv-wrapper"
  description="Production-buildable Vite, Next.js, React Router, and Astro examples for react-7tv-wrapper."
>
  <main class="shell examples-page">
    <header>
      <p class="section-kicker">Copy, run, remix</p>
      <h1>Four environments.<br />No mystery glue.</h1>
      <p>
        Each example is a complete, production-buildable app in the repository.
        Install once at the root, then run the workspace you want to inspect.
      </p>
    </header>

    <div class="example-list">
      {examples.map((example) => (
        <article id={example.id} style={`--accent: ${example.accent}`}>
          <div class="number">{example.number}</div>
          <div class="copy">
            <span>{example.type}</span>
            <h2>{example.title}</h2>
            <p>{example.summary}</p>
          </div>
          <div class="details">
            <code>{example.command}</code>
            <ul>
              {example.files.map((file) => <li>{file}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <aside>
      <b>Build everything</b>
      <code>npm run check:all</code>
      <p>Validates the library and creates production builds for every example.</p>
    </aside>
  </main>
</BaseLayout>

<style>
  .examples-page { padding-block: 90px 120px; }
  header { max-width: 870px; margin-bottom: 80px; }
  h1 { margin: 18px 0 25px; font: 400 clamp(60px, 8.4vw, 104px)/.94 var(--serif); letter-spacing: -.025em; }
  header > p:last-child { max-width: 600px; color: var(--muted); font-size: 16px; line-height: 1.7; }
  .example-list { border-top: 1px solid var(--ink); }
  article { display: grid; grid-template-columns: 70px 1fr 1fr; gap: 35px; padding: 42px 0; border-bottom: 1px solid var(--line); scroll-margin-top: 40px; }
  .number { display: grid; place-items: start center; width: 45px; height: 45px; padding-top: 16px; border-radius: 50%; color: var(--ink); background: var(--accent); font: 700 9px var(--mono); }
  .copy > span { color: var(--violet); font: 700 9px var(--mono); letter-spacing: .12em; text-transform: uppercase; }
  .copy h2 { margin: 10px 0 13px; font: 400 37px var(--serif); letter-spacing: -.01em; }
  .copy p { max-width: 470px; margin: 0; color: var(--muted); font-size: 12px; line-height: 1.65; }
  .details { display: grid; align-content: center; gap: 16px; }
  .details > code, aside code { overflow: auto; padding: 14px 16px; color: #eaff96; background: var(--ink); font: 9px var(--mono); white-space: nowrap; }
  ul { display: flex; flex-wrap: wrap; gap: 7px; margin: 0; padding: 0; list-style: none; }
  li { padding: 7px 9px; border: 1px solid var(--line); font: 8px var(--mono); }
  aside { display: grid; grid-template-columns: auto minmax(280px, 1fr) 1fr; gap: 22px; align-items: center; margin-top: 50px; padding: 24px; border: 1px solid var(--ink); background: var(--acid); }
  aside b { font: 400 21px var(--serif); }
  aside p { margin: 0; color: #515a2c; font-size: 11px; line-height: 1.5; }
  @media (max-width: 760px) {
    article { grid-template-columns: 45px 1fr; }
    .details { grid-column: 2; }
    aside { grid-template-columns: 1fr; }
  }
</style>
