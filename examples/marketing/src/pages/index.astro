---
import { HeroCarousel } from "../components/HeroCarousel";
import { Playground } from "../components/Playground";
import BaseLayout from "../layouts/BaseLayout.astro";

const installCommand = "npm install react-7tv-wrapper";
---

<BaseLayout>
  <main>
    <section class="hero shell">
      <div class="hero-copy">
        <h1>
          Text in.<br />
          <em>Emotes</em> out.
        </h1>
        <p class="hero-lede">
          Drop expressive 7TV emotes into any React text flow. Typed, composable,
          animated, and genuinely safe across client and server environments.
        </p>
        <div class="hero-actions">
          <a class="primary-button" href="#playground">Try the live demo</a>
          <div class="install-command">
            <code>{installCommand}</code>
            <button type="button" data-copy={installCommand}>Copy</button>
          </div>
        </div>
      </div>

      <HeroCarousel client:load />
    </section>

    <section class="proof-strip" aria-label="Package qualities">
      <div class="proof-track">
        <span>React 19</span><i>✳</i>
        <span>Zero runtime dependencies</span><i>✳</i>
        <span>SSR safe</span><i>✳</i>
        <span>Animated + static</span><i>✳</i>
        <span>ESM + CommonJS</span><i>✳</i>
        <span>React 19</span><i>✳</i>
      </div>
    </section>

    <section class="playground-section" id="playground">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="section-kicker">Live playground</p>
            <h2>One component.<br />Your syntax.</h2>
          </div>
          <p>
            Type a message, search aliases, click to insert, switch grammars,
            and stop motion. Every match stays a normal React node.
          </p>
        </div>
        <Playground client:load />
      </div>
    </section>

    <section class="steps shell" id="api">
      <div class="section-heading steps-heading">
        <div>
          <p class="section-kicker">Small surface, deep control</p>
          <h2>From zero to expressive in three moves.</h2>
        </div>
      </div>
      <div class="step-list">
        <article>
          <span>01</span>
          <div>
            <h3>Choose your source</h3>
            <p>Load a remote emote set, fetch on the server, or pass controlled data.</p>
          </div>
          <code>{`<SevenTVProvider emoteSetId="global">`}</code>
        </article>
        <article>
          <span>02</span>
          <div>
            <h3>Choose your grammar</h3>
            <p>Use plain aliases, delimiters, case folding, or bring a tokenizer.</p>
          </div>
          <code>{`syntax={delimitedSyntax(":")}`}</code>
        </article>
        <article>
          <span>03</span>
          <div>
            <h3>Wrap the text</h3>
            <p>Nested inline content is preserved while matching strings become images.</p>
          </div>
          <code>{`<SevenTVText>{message}</SevenTVText>`}</code>
        </article>
      </div>
    </section>

    <section class="frameworks">
      <div class="shell">
        <div class="framework-intro">
          <p class="section-kicker">Bring your framework</p>
          <h2>Same API.<br />Everywhere React lives.</h2>
          <a href="/examples/">Explore all examples <span>→</span></a>
        </div>
        <div class="framework-grid">
          <a href="/examples/#vite"><b>Vite</b><span>Client SPA</span><i>↗</i></a>
          <a href="/examples/#next"><b>Next.js</b><span>Server + Client</span><i>↗</i></a>
          <a href="/examples/#react-router"><b>React Router</b><span>Loader SSR</span><i>↗</i></a>
          <a href="/examples/#astro"><b>Astro</b><span>React island</span><i>↗</i></a>
        </div>
      </div>
    </section>

    <section class="cta shell">
      <p class="section-kicker">Ready when chat is</p>
      <h2>Give every message<br />a little more <em>life.</em></h2>
      <div>
        <code>{installCommand}</code>
        <a href="#api">Read the API overview →</a>
      </div>
    </section>
  </main>

  <script>
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      button.addEventListener("click", async () => {
        const command = button.dataset.copy;
        if (!command) return;
        await navigator.clipboard.writeText(command);
        const oldLabel = button.textContent;
        button.textContent = "Copied";
        window.setTimeout(() => { button.textContent = oldLabel; }, 1400);
      });
    }
  </script>
</BaseLayout>

<style>
  .hero { position: relative; display: grid; grid-template-columns: 1.08fr .92fr; min-height: 690px; padding-block: 92px 80px; }
  .hero-copy { position: relative; z-index: 2; align-self: center; }
  h1 { margin: 0 0 28px; font: 400 clamp(68px, 9.5vw, 132px)/.88 var(--serif); letter-spacing: -.035em; }
  h1 em, .cta h2 em { position: relative; color: var(--violet); font-style: normal; font-weight: 400; }
  h1 em { text-decoration: underline var(--acid) .07em; text-underline-offset: .08em; text-decoration-skip-ink: none; }
  .hero-lede { max-width: 570px; margin: 0; color: var(--muted); font-size: 17px; line-height: 1.7; }
  .hero-actions { display: flex; gap: 12px; align-items: center; margin-top: 35px; }
  .primary-button { padding: 15px 20px; border-radius: 4px; color: var(--paper); background: var(--ink); text-decoration: none; font-size: 12px; font-weight: 700; }
  .install-command { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 4px; background: rgba(255,255,255,.36); }
  .install-command code { font: 10px var(--mono); }
  .install-command button { border: 0; padding: 0; color: var(--violet); background: transparent; font: 700 9px var(--mono); text-transform: uppercase; cursor: pointer; }

  .proof-strip { overflow: hidden; border-block: 1px solid var(--ink); background: var(--acid); }
  .proof-track { display: flex; width: max-content; align-items: center; gap: 26px; padding: 16px 0; animation: marquee 28s linear infinite; }
  .proof-track span { font: 750 10px var(--mono); letter-spacing: .1em; text-transform: uppercase; }
  .proof-track i { font-style: normal; }
  @keyframes marquee { to { transform: translateX(-22%); } }

  .playground-section { padding-block: 120px; background: var(--paper-deep); }
  .section-heading { display: grid; grid-template-columns: 1fr 340px; gap: 70px; align-items: end; margin-bottom: 48px; }
  .section-heading h2, .framework-intro h2, .cta h2 { margin: 18px 0 0; font: 400 clamp(50px, 6.6vw, 82px)/1 var(--serif); letter-spacing: -.02em; }
  .section-heading > p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.7; }

  .steps { padding-block: 125px; }
  .steps-heading { max-width: 780px; grid-template-columns: 1fr; }
  .step-list { border-top: 1px solid var(--ink); }
  .step-list article { display: grid; grid-template-columns: 70px minmax(240px, .8fr) 1fr; gap: 35px; align-items: center; padding: 30px 0; border-bottom: 1px solid var(--line); }
  .step-list article > span { color: var(--violet); font: 700 10px var(--mono); }
  .step-list h3 { margin: 0 0 8px; font: 400 25px var(--serif); }
  .step-list p { max-width: 460px; margin: 0; color: var(--muted); font-size: 12px; line-height: 1.6; }
  .step-list code { justify-self: end; max-width: 100%; overflow: auto; padding: 13px 16px; border: 1px solid var(--line); border-radius: 3px; color: #e7ff8d; background: var(--ink); font: 10px var(--mono); }

  .frameworks { padding-block: 110px; color: var(--paper); background: var(--ink); }
  .frameworks > .shell { display: grid; grid-template-columns: .75fr 1.25fr; gap: 100px; }
  .framework-intro .section-kicker { color: var(--acid); }
  .framework-intro h2 { max-width: 480px; }
  .framework-intro > a { display: inline-flex; gap: 13px; margin-top: 30px; color: #b5afb7; text-decoration: none; font-size: 11px; }
  .framework-intro > a span { color: var(--acid); }
  .framework-grid { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid rgba(255,255,255,.17); border-left: 1px solid rgba(255,255,255,.17); }
  .framework-grid a { position: relative; display: flex; min-height: 180px; flex-direction: column; justify-content: end; padding: 24px; border-right: 1px solid rgba(255,255,255,.17); border-bottom: 1px solid rgba(255,255,255,.17); color: inherit; text-decoration: none; transition: color .2s ease, background .2s ease; }
  .framework-grid a:hover { color: var(--ink); background: var(--acid); }
  .framework-grid b { font: 400 27px var(--serif); }
  .framework-grid span { margin-top: 7px; color: #827d84; font: 9px var(--mono); text-transform: uppercase; }
  .framework-grid i { position: absolute; top: 20px; right: 20px; color: var(--acid); font-style: normal; }
  .framework-grid a:hover i, .framework-grid a:hover span { color: var(--ink); }

  .cta { display: grid; place-items: center; padding-block: 130px; text-align: center; }
  .cta h2 { margin-top: 22px; }
  .cta > div { display: flex; gap: 26px; align-items: center; margin-top: 40px; }
  .cta code { padding: 14px 17px; color: var(--acid); background: var(--ink); font: 10px var(--mono); }
  .cta a { color: var(--ink); font-size: 11px; font-weight: 700; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .hero-carousel { margin-top: 40px; }
    .frameworks > .shell { grid-template-columns: 1fr; gap: 60px; }
  }
  @media (max-width: 700px) {
    .hero { padding-top: 65px; }
    h1 { font-size: clamp(56px, 16vw, 70px); letter-spacing: -.025em; }
    .hero-actions { align-items: stretch; flex-direction: column; }
    .install-command { min-width: 0; justify-content: space-between; }
    .install-command code { flex: 1; overflow: hidden; min-width: 0; text-overflow: ellipsis; white-space: nowrap; }
    .install-command button { flex: 0 0 auto; }
    .hero-copy { min-width: 0; }
    .hero-carousel { left: auto; width: 100%; min-height: 480px; margin-top: 36px; transform: none; }
    .section-heading { grid-template-columns: 1fr; gap: 22px; }
    .step-list article { grid-template-columns: 36px 1fr; }
    .step-list code { grid-column: 2; justify-self: stretch; }
    .framework-grid { grid-template-columns: 1fr; }
    .cta > div { flex-direction: column; }
  }
</style>
